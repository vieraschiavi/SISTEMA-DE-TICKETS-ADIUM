        "lineageTag": "809b924e-919b-46d4-b651-7e77e41e2d43"
      },
      {
        "name": "Calendario",
        "columns": [
          {
            "name": "Fecha",
            "dataType": "dateTime",
            "sourceColumn": "Fecha",
            "isKey": true,
            "lineageTag": "e3dcb3a5-4391-44f4-a7c9-cec37a0639fb",
            "summarizeBy": "none"
          },
          {
            "name": "Año",
            "dataType": "int64",
            "sourceColumn": "Año",
            "formatString": "0",
            "lineageTag": "4f3525a0-0ae3-4880-b12a-5bd270c20a81",
            "summarizeBy": "none"
          },
          {
            "name": "Período",
            "dataType": "string",
            "sourceColumn": "Período",
            "lineageTag": "d0052888-16b6-46ff-82d5-c4e045895815",
            "summarizeBy": "none"
          },
          {
            "name": "Mes nombre",
            "dataType": "string",
            "sourceColumn": "Mes nombre",
            "sortByColumn": "Mes orden",
            "lineageTag": "fbc5c312-f29a-4764-aafa-483f5d561d5f",
            "summarizeBy": "none"
          },
          {
            "name": "Mes orden",
            "dataType": "int64",
            "sourceColumn": "Mes orden",
            "formatString": "0",
            "lineageTag": "6403c3e1-b489-463a-b74f-b35e8deccf47",
            "summarizeBy": "none"
          },
          {
            "name": "Día hábil",
            "dataType": "int64",
            "sourceColumn": "Día hábil",
            "formatString": "#,0",
            "lineageTag": "77c1cdd6-b48e-4c4c-8a10-6c8ab876e8ea",
            "summarizeBy": "none"
          }
        ],
        "partitions": [
          {
            "name": "Calendario",
            "mode": "import",
            "source": {
              "type": "m",
              "expression": [
                "let",
                "    Origen = Excel.Workbook(File.Contents(CarpetaDatos & \"Tickets_Excelencia_Comercial_y_Digital.xlsx\"), true){[Item=\"Calendario\", Kind=\"Sheet\"]}[Data],",
                "    Tipos = Table.TransformColumnTypes(Origen, {{\"Fecha\", type datetime}, {\"Año\", Int64.Type}, {\"Período\", type text}, {\"Mes nombre\", type text}, {\"Mes orden\", Int64.Type}, {\"Día hábil\", Int64.Type}})",
                "in",
                "    Tipos"
              ]
            }
          }
        ],
        "dataCategory": "Time",
        "lineageTag": "7845ebc7-c80c-430c-8e30-3cd96733c68d"
      },
      {
        "name": "_Medidas",
        "columns": [
          {
            "name": "Orden",
            "dataType": "int64",
            "sourceColumn": "Orden",
            "isHidden": true,
            "lineageTag": "2c4cedd8-8bf7-4f58-86f5-d7ac0388f2b0",
            "summarizeBy": "none"
          }
        ],
        "partitions": [
          {
            "name": "_Medidas",
            "mode": "import",
            "source": {
              "type": "m",
              "expression": [
                "let Origen = #table({\"Orden\"}, {{1}}) in Origen"
              ]
            }
          }
        ],
        "measures": [
          {
            "name": "Tickets recibidos",
            "expression": "COUNTROWS('Tickets') + 0",
            "displayFolder": "01 · Volumen",
            "formatString": "#,0",
            "description": "Pedidos que entraron en el período (por fecha de creación)."
          },
          {
            "name": "Tickets resueltos",
            "expression": "VAR ini = MIN('Calendario'[Fecha]) VAR fin = MAX('Calendario'[Fecha]) RETURN CALCULATE(COUNTROWS('Tickets'), REMOVEFILTERS('Calendario'), KEEPFILTERS(NOT ISBLANK('Tickets'[Fecha resolución día]) && 'Tickets'[Fecha resolución día] >= ini && 'Tickets'[Fecha resolución día] <= fin)) + 0",
            "displayFolder": "01 · Volumen",
            "formatString": "#,0",
            "description": "Pedidos resueltos en el período (por fecha de resolución, entren cuando entren)."
          },
          {
            "name": "Backlog fin de período",
            "expression": "VAR fin = MAX('Calendario'[Fecha]) RETURN CALCULATE(COUNTROWS('Tickets'), REMOVEFILTERS('Calendario'), KEEPFILTERS('Tickets'[Fecha] <= fin), KEEPFILTERS(ISBLANK('Tickets'[Fecha salida backlog]) || 'Tickets'[Fecha salida backlog] > fin)) + 0",
            "displayFolder": "01 · Volumen",
            "formatString": "#,0",
            "description": "Pedidos que al último día del período habían entrado y todavía no estaban resueltos ni cancelados."
          },
          {
            "name": "Pendientes del equipo",
            "expression": "SUM('Tickets'[Pendiente equipo]) + 0",
            "displayFolder": "01 · Volumen",
            "formatString": "#,0",
            "description": "Hoy en Nuevo, Asignado, En curso o Reabierto (corre el reloj del SLA)."
          },
          {
            "name": "Pendientes por antigüedad",
            "expression": "VAR n = [Pendientes del equipo] RETURN IF(n > 0, n)",
            "displayFolder": "01 · Volumen",
            "formatString": "#,0",
            "description": "Pendientes del equipo, sin las categorías vacías (para el gráfico por antigüedad)."
          },
          {
            "name": "Vencidos sin resolver",
            "expression": "SUM('Tickets'[Vencido]) + 0",
            "displayFolder": "01 · Volumen",
            "formatString": "#,0",
            "description": "Pendientes del equipo que ya pasaron su SLA."
          },
          {
            "name": "Vencido (pendientes)",
            "expression": "IF([Pendientes del equipo] > 0, [Vencidos sin resolver])",
            "displayFolder": "01 · Volumen",
            "formatString": "#,0",
            "description": "Vencidos sin resolver, en blanco para lo que no está pendiente: la tabla de abiertos muestra sólo abiertos."
          },
          {
            "name": "Cancelados",
            "expression": "SUM('Tickets'[Cancelado]) + 0",
            "displayFolder": "01 · Volumen",
            "formatString": "#,0",
            "description": "Pedidos cancelados (duplicados, fuera de alcance o retirados)."
          },
          {
            "name": "Solicitantes",
            "expression": "DISTINCTCOUNT('Tickets'[Mail solicitante]) + 0",
            "displayFolder": "01 · Volumen",
            "formatString": "#,0",
            "description": "Personas distintas que pidieron."
          },
          {
            "name": "Áreas que piden",
            "expression": "DISTINCTCOUNT('Tickets'[Área solicitante]) + 0",
            "displayFolder": "01 · Volumen",
            "formatString": "#,0",
            "description": "Áreas solicitantes distintas con al menos un pedido."
          },
          {
            "name": "% en SLA",
            "expression": "AVERAGE('Tickets'[En SLA])",
            "displayFolder": "02 · Tiempos y SLA",
            "formatString": "0.0%",
            "description": "De los resueltos, cuántos en el plazo de su tipo y prioridad (horas hábiles, sin el tiempo en espera del solicitante)."
          },
          {
            "name": "% respuesta en SLA",
            "expression": "AVERAGE('Tickets'[Respuesta en SLA])",
            "displayFolder": "02 · Tiempos y SLA",
            "formatString": "0.0%",
            "description": "Primera respuesta del equipo dentro del plazo de su prioridad."
          },
          {
            "name": "Horas primera respuesta",
            "expression": "AVERAGE('Tickets'[Horas primera respuesta])",
            "displayFolder": "02 · Tiempos y SLA",
            "formatString": "#,0.0",
            "description": "Horas hábiles hasta que el equipo respondió o empezó."
          },
          {
            "name": "Días de resolución",
            "expression": "AVERAGE('Tickets'[Días resolución])",
            "displayFolder": "02 · Tiempos y SLA",
            "formatString": "#,0.0",
            "description": "Días hábiles efectivos de la creación a la resolución (sin la espera del solicitante)."
          },
          {
            "name": "Días de resolución (mediana)",
            "expression": "PERCENTILEX.INC(CALCULATETABLE('Tickets', KEEPFILTERS(NOT ISBLANK('Tickets'[Días resolución]))), 'Tickets'[Días resolución], 0.5)",
            "displayFolder": "02 · Tiempos y SLA",
            "formatString": "#,0.0",
            "description": "La mitad se resolvió en menos de esto: no la mueven los pocos pedidos larguísimos."
          },
          {
            "name": "SLA en días",
            "expression": "AVERAGE('Tickets'[SLA días])",
            "displayFolder": "02 · Tiempos y SLA",
            "formatString": "#,0.0",
            "description": "El plazo de resolución acordado (matriz tipo × prioridad)."
          },
          {
            "name": "Días abierto",
            "expression": "AVERAGE('Tickets'[Días abierto])",
            "displayFolder": "02 · Tiempos y SLA",
            "formatString": "#,0.0",
            "description": "Días hábiles efectivos que llevan abiertos los pendientes."
          },
          {
            "name": "Horas en estado",
            "expression": "AVERAGE('Estados'[Horas en estado])",
            "displayFolder": "02 · Tiempos y SLA",
            "formatString": "#,0.0",
            "description": "Horas hábiles promedio que un ticket pasa en cada estado."
          },
          {
            "name": "Pasos por el estado",
            "expression": "COUNTROWS('Estados') + 0",
            "displayFolder": "02 · Tiempos y SLA",
            "formatString": "#,0",
            "description": "Cuántas veces un ticket entró al estado."
          },
          {
            "name": "Tasa de reapertura",
            "expression": "DIVIDE(CALCULATE(COUNTROWS('Tickets'), KEEPFILTERS('Tickets'[Resuelto] = 1), KEEPFILTERS('Tickets'[Reaperturas] > 0)), CALCULATE(COUNTROWS('Tickets'), KEEPFILTERS('Tickets'[Resuelto] = 1)))",
            "displayFolder": "03 · Conformidad",
            "formatString": "0.0%",
            "description": "Resueltos que el solicitante devolvió al menos una vez («No conforme»)."
          },
          {
            "name": "% sin idas y vueltas",
            "expression": "AVERAGE('Tickets'[Primer contacto])",
            "displayFolder": "03 · Conformidad",
            "formatString": "0.0%",
            "description": "Resueltos sin pedir datos al solicitante y sin reaperturas."
          },
          {
            "name": "Encuestas enviadas",
            "expression": "COUNTROWS('Encuestas') + 0",
            "displayFolder": "03 · Conformidad",
            "formatString": "#,0",
            "description": "Encuestas de conformidad enviadas (una por cada resolución, incluidas las de tickets reabiertos)."
          },
          {
            "name": "Conformes",
            "expression": "CALCULATE(COUNTROWS('Encuestas'), KEEPFILTERS('Encuestas'[Resultado] = \"Conforme\")) + 0",
            "displayFolder": "03 · Conformidad",
            "formatString": "#,0",
            "description": "Encuestas respondidas «Sí, conforme»."
          },
          {
            "name": "No conformes",
            "expression": "CALCULATE(COUNTROWS('Encuestas'), KEEPFILTERS('Encuestas'[Resultado] = \"No conforme\")) + 0",
            "displayFolder": "03 · Conformidad",
            "formatString": "#,0",
            "description": "Encuestas respondidas «No, falta algo»: cada una reabre el ticket."
          },
          {
            "name": "Conformidad tácita",
            "expression": "CALCULATE(COUNTROWS('Encuestas'), KEEPFILTERS('Encuestas'[Resultado] = \"Tácita\")) + 0",
            "displayFolder": "03 · Conformidad",
            "formatString": "#,0",
            "description": "Cerrados sin respuesta a la encuesta en los días hábiles de gracia."
          },
          {
            "name": "% de respuesta a la encuesta",
            "expression": "DIVIDE([Conformes] + [No conformes], [Conformes] + [No conformes] + [Conformidad tácita])",
            "displayFolder": "03 · Conformidad",
            "formatString": "0.0%",
            "description": "Encuestas respondidas sobre encuestas cerradas (respondidas + tácitas)."
          },
          {
            "name": "% conformidad",
            "expression": "DIVIDE([Conformes], [Conformes] + [No conformes])",
            "displayFolder": "03 · Conformidad",
            "formatString": "0.0%",
            "description": "De los que respondieron la encuesta, cuántos quedaron conformes."
          },
          {
            "name": "% conformidad con tácita",
            "expression": "DIVIDE([Conformes] + [Conformidad tácita], [Conformes] + [No conformes] + [Conformidad tácita])",
            "displayFolder": "03 · Conformidad",
            "formatString": "0.0%",
            "description": "Cuenta como conforme el silencio después de los días de gracia."
          },
          {
            "name": "Satisfacción (1 a 5)",
            "expression": "AVERAGE('Encuestas'[CSAT])",
            "displayFolder": "03 · Conformidad",
            "formatString": "0.00",
            "description": "Promedio de la nota de 1 a 5 que dejó el solicitante en la encuesta."
          },
          {
            "name": "% satisfechos (4 y 5)",
            "expression": "DIVIDE(CALCULATE(COUNT('Encuestas'[CSAT]), KEEPFILTERS('Encuestas'[CSAT] >= 4)), COUNT('Encuestas'[CSAT]))",
            "displayFolder": "03 · Conformidad",
            "formatString": "0.0%",
            "description": "De las notas de satisfacción, cuántas fueron 4 o 5."
          },
          {
            "name": "Índice de efectividad",
            "expression": "VAR s = [% en SLA] VAR c = [% conformidad con tácita] VAR r = [Tasa de reapertura] RETURN IF(NOT ISBLANK(s) && NOT ISBLANK(c) && NOT ISBLANK(r), 0.4 * s + 0.4 * c + 0.2 * (1 - r))",
            "displayFolder": "03 · Conformidad",
            "formatString": "0.0%",
            "description": "40 % cumplir el plazo + 40 % conformidad (con tácita) + 20 % que no vuelva (1 − reapertura)."
          },
          {
            "name": "Nota recibidos",
            "expression": "FORMAT([Tickets resueltos], \"#,0\") & \" resueltos en el período\"",
            "displayFolder": "04 · Notas",
            "description": "Texto debajo de la tarjeta de recibidos."
          },
          {
            "name": "Signo flujo",
            "expression": "[Tickets resueltos] - [Tickets recibidos]",
            "displayFolder": "04 · Notas",
            "formatString": "#,0",
            "description": "Positivo: salió más de lo que entró (el backlog baja)."
          },
          {
            "name": "Nota backlog",
            "expression": "FORMAT([Vencidos sin resolver], \"#,0\") & \" vencidos sin resolver\"",
            "displayFolder": "04 · Notas",
            "description": "Texto debajo de la tarjeta de backlog."
          },
          {
            "name": "Signo vencidos",
            "expression": "0 - [Vencidos sin resolver]",
            "displayFolder": "04 · Notas",
            "formatString": "#,0",
            "description": "Negativo si hay vencidos: pinta de rojo la nota."
          },
          {
            "name": "Nota SLA",
            "expression": "FORMAT([% respuesta en SLA], \"0%\") & \" de primeras respuestas en plazo · meta 85 %\"",
            "displayFolder": "04 · Notas",
            "description": "Texto debajo de la tarjeta de SLA."
          },
          {
            "name": "Signo SLA",
            "expression": "[% en SLA] - 0.85",
            "displayFolder": "04 · Notas",
            "formatString": "0.0%",
            "description": "Distancia a la meta de 85 %: pinta la nota de verde o rojo."
          },
          {
            "name": "Nota resolución",
            "expression": "\"mediana \" & FORMAT([Días de resolución (mediana)], \"0.0\") & \" días hábiles\"",
            "displayFolder": "04 · Notas",
            "description": "Texto debajo de la tarjeta de días de resolución."
          },
          {
            "name": "Nota conformidad",
            "expression": "FORMAT([% de respuesta a la encuesta], \"0%\") & \" respondió la encuesta\"",
            "displayFolder": "04 · Notas",
            "description": "Texto debajo de la tarjeta de conformidad."
          },
          {
            "name": "Signo conformidad",
            "expression": "[% conformidad con tácita] - 0.85",
            "displayFolder": "04 · Notas",
            "formatString": "0.0%",
            "description": "Distancia a la meta de 85 %."
          },
          {
            "name": "Nota índice",
            "expression": "\"40 % SLA · 40 % conformidad · 20 % sin reapertura\"",
            "displayFolder": "04 · Notas",
            "description": "Cómo se arma el índice de efectividad."
          },
          {
            "name": "Signo índice",
            "expression": "[Índice de efectividad] - 0.85",
            "displayFolder": "04 · Notas",
            "formatString": "0.0%",
            "description": "Distancia a la meta de 85 %."
          },
          {
            "name": "Nota satisfacción",
            "expression": "FORMAT([% satisfechos (4 y 5)], \"0%\") & \" puso 4 o 5\"",
            "displayFolder": "04 · Notas",
            "description": "Texto debajo de la tarjeta de satisfacción."
          },
          {
            "name": "Filtros activos",
            "expression": "VAR F1 = IF ( ISFILTERED ( 'Calendario'[Año] ), \"Año: \" & IF ( COUNTROWS ( VALUES ( 'Calendario'[Año] ) ) > 3, COUNTROWS ( VALUES ( 'Calendario'[Año] ) ) & \" elegidos\", CONCATENATEX ( VALUES ( 'Calendario'[Año] ), 'Calendario'[Año], \", \", 'Calendario'[Año], ASC ) ) )\nVAR S1 = F1\nVAR F2 = IF ( ISFILTERED ( 'Calendario'[Período] ), \"Período: \" & IF ( COUNTROWS ( VALUES ( 'Calendario'[Período] ) ) > 3, COUNTROWS ( VALUES ( 'Calendario'[Período] ) ) & \" elegidos\", CONCATENATEX ( VALUES ( 'Calendario'[Período] ), 'Calendario'[Período], \", \", 'Calendario'[Período], ASC ) ) )\nVAR S2 = IF ( F2 = \"\", S1, IF ( S1 = \"\", F2, S1 & \"  ·  \" & F2 ) )\nVAR F3 = IF ( ISFILTERED ( 'Tickets'[Número] ), \"Número: \" & IF ( COUNTROWS ( VALUES ( 'Tickets'[Número] ) ) > 3, COUNTROWS ( VALUES ( 'Tickets'[Número] ) ) & \" elegidos\", CONCATENATEX ( VALUES ( 'Tickets'[Número] ), 'Tickets'[Número], \", \", 'Tickets'[Número], ASC ) ) )\nVAR S3 = IF ( F3 = \"\", S2, IF ( S2 = \"\", F3, S2 & \"  ·  \" & F3 ) )\nVAR F4 = IF ( ISFILTERED ( 'Tickets'[Asunto] ), \"Asunto: \" & IF ( COUNTROWS ( VALUES ( 'Tickets'[Asunto] ) ) > 3, COUNTROWS ( VALUES ( 'Tickets'[Asunto] ) ) & \" elegidos\", CONCATENATEX ( VALUES ( 'Tickets'[Asunto] ), 'Tickets'[Asunto], \", \", 'Tickets'[Asunto], ASC ) ) )\nVAR S4 = IF ( F4 = \"\", S3, IF ( S3 = \"\", F4, S3 & \"  ·  \" & F4 ) )\nVAR F5 = IF ( ISFILTERED ( 'Tickets'[Solicitante] ), \"Solicitante: \" & IF ( COUNTROWS ( VALUES ( 'Tickets'[Solicitante] ) ) > 3, COUNTROWS ( VALUES ( 'Tickets'[Solicitante] ) ) & \" elegidos\", CONCATENATEX ( VALUES ( 'Tickets'[Solicitante] ), 'Tickets'[Solicitante], \", \", 'Tickets'[Solicitante], ASC ) ) )\nVAR S5 = IF ( F5 = \"\", S4, IF ( S4 = \"\", F5, S4 & \"  ·  \" & F5 ) )\nRETURN IF ( S5 = \"\", \"Sin filtros\", \"Filtros: \" & S5 )",
            "displayFolder": "00 · Navegación",
            "description": "Qué está filtrado ahora, en una línea."
          }
        ],
        "lineageTag": "5f658644-06ca-492d-b701-deaa924d85bf"
      }
    ],
    "relationships": [
