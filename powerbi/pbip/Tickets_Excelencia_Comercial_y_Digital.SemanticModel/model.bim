    "annotations": [
      {
        "name": "PBI_QueryOrder",
        "value": "[\"Tickets\", \"Estados\", \"Encuestas\", \"Calendario\", \"_Medidas\"]"
      },
      {
        "name": "MVDaxLab_Gobernanza",
        "value": "{\"formato\":1,\"generador\":\"MV DAX Lab\",\"generado\":\"2026-10-21 13:01 UTC\",\"idioma\":\"es\",\"empresa_propia\":\"\",\"tablas\":[{\"nombre\":\"Tickets\",\"filas\":null,\"columnas\":52,\"papel\":\"dimension\",\"origen\":\"parametro\",\"oculta\":false},{\"nombre\":\"Estados\",\"filas\":null,\"columnas\":7,\"papel\":\"hecho\",\"origen\":\"parametro\",\"oculta\":false},{\"nombre\":\"Encuestas\",\"filas\":null,\"columnas\":9,\"papel\":\"hecho\",\"origen\":\"parametro\",\"oculta\":false},{\"nombre\":\"Calendario\",\"filas\":null,\"columnas\":6,\"papel\":\"calendario\",\"origen\":\"parametro\",\"oculta\":false},{\"nombre\":\"_Medidas\",\"filas\":null,\"columnas\":1,\"papel\":\"suelta\",\"origen\":\"calculada\",\"oculta\":false}],\"medidas\":[{\"nombre\":\"% conformidad\",\"tabla\":\"_Medidas\",\"carpeta\":\"03 · Conformidad\",\"formato\":\"0.0%\",\"porque\":\"Divide con DIVIDE y no con «/»: si el denominador es cero devuelve vacío en vez de un error que rompe el visual.\"},{\"nombre\":\"% conformidad con tácita\",\"tabla\":\"_Medidas\",\"carpeta\":\"03 · Conformidad\",\"formato\":\"0.0%\",\"porque\":\"Divide con DIVIDE y no con «/»: si el denominador es cero devuelve vacío en vez de un error que rompe el visual.\"},{\"nombre\":\"% de respuesta a la encuesta\",\"tabla\":\"_Medidas\",\"carpeta\":\"03 · Conformidad\",\"formato\":\"0.0%\",\"porque\":\"Divide con DIVIDE y no con «/»: si el denominador es cero devuelve vacío en vez de un error que rompe el visual.\"},{\"nombre\":\"% en SLA\",\"tabla\":\"_Medidas\",\"carpeta\":\"02 · Tiempos y SLA\",\"formato\":\"0.0%\",\"porque\":\"Cálculo directo, sin modificar el contexto de filtro.\"},{\"nombre\":\"% respuesta en SLA\",\"tabla\":\"_Medidas\",\"carpeta\":\"02 · Tiempos y SLA\",\"formato\":\"0.0%\",\"porque\":\"Cálculo directo, sin modificar el contexto de filtro.\"},{\"nombre\":\"% satisfechos (4 y 5)\",\"tabla\":\"_Medidas\",\"carpeta\":\"03 · Conformidad\",\"formato\":\"0.0%\",\"porque\":\"Agrega la 