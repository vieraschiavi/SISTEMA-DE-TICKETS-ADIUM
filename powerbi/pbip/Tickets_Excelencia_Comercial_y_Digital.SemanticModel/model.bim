        "partitions": [
          {
            "name": "Tickets",
            "mode": "import",
            "source": {
              "type": "m",
              "expression": [
                "let",
                "    Origen = Excel.Workbook(File.Contents(CarpetaDatos & \"Tickets_Excelencia_Comercial_y_Digital.xlsx\"), true){[Item=\"Tickets\", Kind=\"Sheet\"]}[Data],",
                "    Tipos = Table.TransformColumnTypes(Origen, {{\"Número\", type text}, {\"Asunto\", type text}, {\"Solicitante\", type text}, {\"Mail solicitante\", type text}, {\"Área solicitante\", type text}, {\"País\", type text}, {\"Tipo de ticket\", type text}, {\"Subtipo\", type text}, {\"Prioridad\", type text}, {\"Orden prioridad\", Int64.Type}, {\"Canal\", type text}, {\"ATC\", type text}, {\"ATC nivel 1\", type text}, {\"Área terapéutica\", type text}, {\"Unidad de negocio\", type text}, {\"Mercado\", type text}, {\"Fuente de datos\", type text}, {\"Tablero\", type text}, {\"Estado\", type text}, {\"Orden estado\", Int64.Type}, {\"Subestado\", type text}, {\"Equipo resolutor\", type text}, {\"Analista\", type text}, {\"Fecha creación\", type datetime}, {\"Fecha\", type datetime}, {\"Fecha asignación\", type datetime}, {\"Fecha primera respuesta\", type datetime}, {\"Fecha resolución\", type datetime}, {\"Fecha resolución día\", type datetime}, {\"Fecha cierre\", type datetime}, {\"Fecha cancelación\", type datetime}, {\"Fecha salida backlog\", type datetime}, {\"Horas primera respuesta\", type number}, {\"Respuesta en SLA\", Int64.Type}, {\"Horas resolución\", type number}, {\"Días resolución\", type number}, {\"SLA horas\", Int64.Type}, {\"SLA días\", Int64.Type}, {\"En SLA\", Int64.Type}, {\"Horas en espera\", type number}, {\"Resuelto\", Int64.Type}, {\"Cancelado\", Int64.Type}, {\"Pendiente equipo\", Int64.Type}, {\"Vencido\", Int64.Type}, {\"Días abierto\", type number}, {\"Antigüedad\", type text}, {\"Reaperturas\", Int64.Type}, {\"Veces en espera\", Int64.Type}, {\"Primer contacto\", Int64.Type}, {\"Conformidad\", type text}, {\"CSAT\", Int64.Type}}),",
                "    Mascara1 = Table.AddColumn(Tipos, \"Mail solicitante (enmascarado)\", each let t = if [Mail solicitante] = null then null else Text.From([Mail solicitante]), a = if t = null then -1 else Text.PositionOf(t, \"@\") in if t = null then null else if a > 2 then Text.Start(t, 2) & \"•••\" & Text.Middle(t, a) else \"•••\", type text)",
                "in",
                "    Mascara1"
              ]
            }
          }
        ],
        "lineageTag": "d49ffb40-5e5e-419f-8582-aa365748143c"
